# PostgreSQL
POSTGRES_DB=cinema_db
POSTGRES_USER=cinema_user
POSTGRES_PASSWORD=cinema_password
POSTGRES_HOST=cinema_db
POSTGRES_DB_PORT=5432

# JWT
SECRET_KEY_ACCESS=change-me-access
SECRET_KEY_REFRESH=change-me-refresh
JWT_SIGNING_ALGORITHM=HS256

# Email (MailHog in development)
EMAIL_HOST=cinema_mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=cinema
EMAIL_HOST_PASSWORD=cinema
EMAIL_USE_TLS=False
MAILHOG_API_PORT=8025

# Celery / Redis
REDIS_URL=redis://cinema_redis:6379/0

# Links inside emails
BASE_FRONTEND_URL=http://127.0.0.1

# API documentation access (/docs, /redoc, /openapi.json)
DOCS_USERNAME=docs
DOCS_PASSWORD=change-me
